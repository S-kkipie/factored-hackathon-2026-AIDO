# Organizer S3 (read-only). Values are in the organizer data dictionary; never commit .env.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-2
S3_BUCKET=factored-datathon-2026-s3-157725502942-us-east-2-an

# Database. Supabase Postgres connection string (Project Settings → Database → Connection string → Session pooler).
# Leave empty to use a local PGlite database in data/pglite (no account needed).
DATABASE_URL=

# Gemini (free key at https://aistudio.google.com/apikey). Empty = templates + escalation only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Server
JWT_SECRET=
DEMO_PIN=2468
AGENT_PIN=1357
SAFE_MODE=0
