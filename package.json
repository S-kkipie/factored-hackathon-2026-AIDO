{
  "name": "factored-hackathon-2026-aido",
  "private": true,
  "type": "module",
  "scripts": {
    "download": "bun pipeline/download.ts",
    "pipeline": "bun pipeline/run.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "dev": "bun --watch server/main.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "start": "bun server/main.ts",
    "smoke": "bun server/smoke.ts",
    "ml:generate": "bun ml/generate.ts",
    "train": "bun ml/train.ts",
    "eval:build": "bun eval/build.ts",
    "eval": "bun eval/main.ts",
    "eval:judge": "bun eval/judge-main.ts",
    "eval:label": "bun eval/label.ts",
    "redteam": "mkdir -p redteam/output && PROMPTFOO_DISABLE_TELEMETRY=1 PROMPTFOO_DISABLE_SHARING=1 npx --yes promptfoo@0.123.1 redteam run -c redteam/promptfooconfig.yaml -o redteam/output/redteam.yaml -j 4 && PROMPTFOO_DISABLE_TELEMETRY=1 npx --yes promptfoo@0.123.1 export eval latest -o redteam/output/results.json",
    "redteam:report": "bun eval/redteam/report.ts"
  },
  "dependencies": {
    "@ag-ui/client": "1.0.1",
    "@ag-ui/core": "1.0.1",
    "@ag-ui/encoder": "1.0.1",
    "@duckdb/node-api": "^1.5.6-r.1",
    "@google/genai": "2.27.0",
    "@langchain/core": "1.2.14",
    "@langchain/langgraph": "1.4.18",
    "@langchain/langgraph-checkpoint": "1.1.5",
    "@sinclair/typebox": "^0.34.52",
    "@tanstack/react-router": "1.170.41",
    "elysia": "1.4.30",
    "jose": "^6.2.12",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "^7.0.2",
    "vite": "8.3.2"
  }
}
